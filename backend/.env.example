PORT=5000
JWT_SECRET=replace_with_a_long_random_secret

# DynamoDB table names (must match template.yaml)
USERS_TABLE=ewaste-users
PRODUCTS_TABLE=ewaste-products
PAYMENTS_TABLE=ewaste-payments

# S3 bucket for product photo uploads
UPLOADS_BUCKET=ewaste-uploads-dev

# AWS region (only needed when running locally without a profile)
# AWS_REGION=ap-south-1
