{
  "name": "e-waste-management-system",
  "version": "1.0.0",
  "description": "Full Stack E-Waste Management System — Express/DynamoDB + React/Vite + AWS Lambda/SAM/Vercel",
  "workspaces": [
    "backend",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"cyan,green\" \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix client",
    "install:all": "npm install --prefix backend && npm install --prefix client",
    "seed": "node backend/scripts/seed-admin.js",
    "server": "npm start --prefix backend",
    "dev:server": "npm run dev --prefix backend",
    "client": "npm run dev --prefix client",
    "build:client": "npm run build --prefix client",
    "sam:build": "sam build",
    "sam:local": "sam local start-api --env-vars env.json --port 5000",
    "sam:deploy": "sam deploy --guided"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@vendia/serverless-express": "^4.10.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.16"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
